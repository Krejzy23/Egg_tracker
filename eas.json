{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "adi": { 
      "extends": "production", 
      "android": { 
        "buildType": "apk" 
      } 
    },

    "production": {
